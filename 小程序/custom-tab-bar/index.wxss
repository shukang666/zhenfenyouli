/* 悬浮胶囊 Tab — 强毛玻璃 */

.custom-tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(20rpx + constant(safe-area-inset-bottom));
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  z-index: 9999;
  background: transparent;
  pointer-events: none;
}

.tab-bar-content {
  pointer-events: auto;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: 104rpx;
  margin: 0 28rpx;
  overflow: hidden;
  border-radius: 52rpx;
  background: rgba(255, 255, 255, 0.52);
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  box-shadow:
    0 16rpx 48rpx rgba(0, 0, 0, 0.08),
    0 1rpx 0 rgba(255, 255, 255, 0.95) inset,
    0 0 0 1rpx rgba(0, 0, 0, 0.04);
  backdrop-filter: saturate(200%) blur(48px);
  -webkit-backdrop-filter: saturate(200%) blur(48px);
}

.tab-indicator {
  position: absolute;
  left: 0;
  top: 10rpx;
  bottom: 10rpx;
  width: 20%;
  z-index: 0;
  pointer-events: none;
  box-sizing: border-box;
  padding: 0 10rpx;
  background-clip: content-box;
  background-color: rgba(255, 255, 255, 0.72);
  border-radius: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  transform: translate3d(0, 0, 0);
}

.tab-indicator--anim {
  transition: transform 0.28s cubic-bezier(0.25, 0.8, 0.25, 1);
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 100%;
  position: relative;
  z-index: 1;
}

.tab-item--press {
  opacity: 0.65;
}

.tab-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
  opacity: 0.38;
}

.tab-item.is-active .tab-icon {
  opacity: 1;
}

.tab-text {
  margin-top: -2rpx;
  font-size: 20rpx;
  color: #8e8e93;
  line-height: 1.2;
  font-weight: 400;
  letter-spacing: 0.4rpx;
}

.tab-item.is-active .tab-text {
  color: #12962e;
  font-weight: 600;
}
