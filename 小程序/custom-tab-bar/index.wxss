/* ========== 瑞幸咖啡风格 Custom Tabbar ========== */

.custom-tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 9999;
  padding-bottom: env(safe-area-inset-bottom);
  padding-bottom: constant(safe-area-inset-bottom);
}

/* 背景层：透明，让页面内容透出来 */
.tab-bar-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: transparent;
}

/* 内容区：瑞幸风格 - 白色圆角胶囊 */
.tab-bar-content {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin: 0 24rpx 16rpx;
  height: 100rpx;
  background: #ffffff;
  border-radius: 50rpx;
  box-shadow:
    0 4rpx 20rpx rgba(0, 0, 0, 0.08),
    0 1rpx 4rpx rgba(0, 0, 0, 0.04);
}

/* 单个 tab 项 */
.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 100%;
  position: relative;
}

/* 图标容器：选中时显示绿色圆形背景 */
.tab-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.tab-icon-wrap--active {
  background: #18AF38;
  box-shadow: 0 2rpx 8rpx rgba(24, 175, 56, 0.3);
  transform: scale(1.05);
}

/* 图标：未选中灰色，选中白色 */
.tab-icon {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.5;
  transition: all 0.25s ease;
}

.tab-icon-wrap--active .tab-icon {
  opacity: 1;
  filter: brightness(0) invert(1); /* 图标变白 */
}

/* 文字 */
.tab-text {
  margin-top: 2rpx;
  font-size: 20rpx;
  color: #999999;
  line-height: 1.3;
  font-weight: 400;
  transition: all 0.25s ease;
  letter-spacing: 0.5rpx;
}

.tab-text--active {
  color: #333333;
  font-weight: 600;
}
