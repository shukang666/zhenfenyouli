/* 悬浮胶囊 Tab：滑块默认无过渡，就位后再开位移，避免新页从首页滑过来 */

.custom-tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(16rpx + constant(safe-area-inset-bottom));
  bottom: calc(16rpx + env(safe-area-inset-bottom));
  z-index: 9999;
  background: transparent;
  pointer-events: none;
}

.tab-bar-content {
  pointer-events: auto;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: 108rpx;
  margin: 0 24rpx;
  overflow: hidden;
  border-radius: 54rpx;
  background: rgba(255, 255, 255, 0.68);
  border: 1rpx solid rgba(255, 255, 255, 0.55);
  box-shadow:
    0 8rpx 32rpx rgba(0, 0, 0, 0.08),
    0 1rpx 0 rgba(255, 255, 255, 0.7) inset;
  backdrop-filter: saturate(180%) blur(24px);
  -webkit-backdrop-filter: saturate(180%) blur(24px);
}

.tab-indicator {
  position: absolute;
  left: 0;
  top: 8rpx;
  bottom: 8rpx;
  width: 20%;
  z-index: 0;
  pointer-events: none;
  box-sizing: border-box;
  padding: 0 10rpx;
  background-clip: content-box;
  background-color: rgba(24, 175, 56, 0.14);
  border-radius: 40rpx;
  transform: translate3d(0, 0, 0);
}

.tab-indicator--anim {
  transition: transform 0.28s ease-out;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 100%;
  position: relative;
  z-index: 1;
}

.tab-item--press {
  opacity: 0.72;
}

.tab-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
  opacity: 0.42;
}

.tab-item.is-active .tab-icon {
  opacity: 1;
}

.tab-text {
  margin-top: -2rpx;
  font-size: 20rpx;
  color: #8e8e93;
  line-height: 1.2;
  font-weight: 400;
  letter-spacing: 0.2rpx;
}

.tab-item.is-active .tab-text {
  color: #18af38;
  font-weight: 600;
}
